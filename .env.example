# Copy to .env. Only needed for --profile premium; the dev profile runs offline for free.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ARK_API_KEY=
# optional, default https://ark.ap-southeast.bytepluses.com
ARK_BASE_URL=
# --profile premium-openrouter: Seedance via OpenRouter
OPENROUTER_API_KEY=
# optional, openrouter-video only: 480p | 720p (default 720p); 480p for cheap tests
HWVA_VIDEO_RESOLUTION=
# optional money cap per run in USD (default 3.0); paid image/video calls stop once reached
HWVA_MAX_COST_USD=
